# 全库固定 LF：Windows 的 core.autocrlf 会把文本检出成 CRLF，
# 导致按字节比对或按内容校验的实现本地通过、CI 失败
* text=auto eol=lf

# 发布归档时排除开发期文件，接入方 composer 下载的包只保留运行所需内容
/.github export-ignore
/tests export-ignore
# tools 只排除本仓自检脚本；升级体检与数字码扫描随包，接入项目可用
/tools/check-package.php export-ignore
/tools/parity-audit.php export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon export-ignore
/phpstan-deprecation.neon export-ignore
/phpunit.xml.dist export-ignore

# 发版与文档站工具链不随包分发
/docs export-ignore
/scripts export-ignore
/package.json export-ignore
/pnpm-lock.yaml export-ignore
/.changeset export-ignore
/.gitlab-ci.yml export-ignore
/.node-version export-ignore

# 协作与任务元数据不随包分发
/.tasks export-ignore
/.trae export-ignore
/.agents export-ignore
/AGENTS.md export-ignore

# 本地安装产物与工具缓存不随包分发
/node_modules export-ignore
/vendor export-ignore
/composer.lock export-ignore
/.phpunit.cache export-ignore
/.screenshots export-ignore
/.php-cs-fixer.cache export-ignore

# 内置资源按 1.6.1 原始字节分发，固定 LF，避免平台自动转换造成哈希不一致
/resources/language/** text eol=lf
/resources/config/** text eol=lf
# 对等矩阵随包分发，接入项目的 upgrade 需要读取，按 LF 固定保证逐字节可比
/resources/parity/** text eol=lf
