{
  "name": "@fxri/fxyin",
  "version": "2.2.2",
  "private": true,
  "description": "风音框架的发版与文档站工具链（不发布 npm 包）",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/fxri-net/fxyin.git"
  },
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:typecheck": "tsc --noEmit -p docs/.vitepress",
    "docs:build": "pnpm docs:typecheck && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "sync:changelog-doc": "node scripts/sync-changelog-doc.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.21",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
